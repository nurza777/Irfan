<?xml version="1.0" encoding="utf-8"?>
<!--
  Запрет на удаление записи азана.

  Обрезчик ресурсов (он включается вместе с сокращателем кода в релизных
  сборках) выбрасывает всё, на что нет ссылок в скомпилированном коде.
  На азан ссылается строка в Dart — `RawResourceAndroidNotificationSound('azan')`,
  — и для обрезчика её не существует. В отчёте это выглядело так:

      @kg.irfan.irfan:raw/azan : reachable=false

  Файл лежал в проекте, собирался, попадал в промежуточные каталоги — и
  не доходил до APK. Уведомление о намазе на Android звучало бы обычным
  системным звуком, и понять почему было бы нечем: ошибки нет, файл на месте.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/azan" />
