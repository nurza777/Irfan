<?xml version="1.0" encoding="utf-8"?>
<!--
  Начиная с Android 9 открытый HTTP запрещён по умолчанию, и без этого файла
  приложение вообще не видит сервер: молча отваливаются курсы, новости, эфир
  и реестр. На iOS ту же роль играло ATS-исключение в Info.plist.

  Исключение сделано ТОЧЕЧНО — только для нынешнего адреса сервера, а не для
  всей сети. Как только заработает домен (tools/go-https.sh), этот файл нужно
  удалить вместе со ссылкой на него в AndroidManifest.xml: по HTTPS он не
  нужен, а лишнее разрешение на открытый трафик — это дыра, через которую
  данные учеников можно прочитать в чужом Wi-Fi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">178.104.206.100</domain>
    </domain-config>
</network-security-config>
